# OralCheck Agent — required environment variables
# Copy this file to .env and fill in your values.

# Anthropic API key (generate content)
ANTHROPIC_API_KEY=

# fal.ai API key (generate images and videos)
FAL_KEY=

# Publora API key (post to Instagram)
PUBLORA_API_KEY=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (message @userinfobot to get yours)
TELEGRAM_CHAT_ID=

# --- World map mode (--map flag) ---
# GA4 property ID — numbers only, no "properties/" prefix
# Find it: GA → Admin → Property Settings → Property ID
GA_PROPERTY_ID=

# (Optional) Path to a service account JSON key file.
# Leave blank to use Application Default Credentials instead:
#   gcloud auth application-default login
GA_SERVICE_ACCOUNT_KEY_PATH=
