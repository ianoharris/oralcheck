# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is the only setup doc for keys
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python virtualenvs
venv/
.venv*/

# Queued posts are per-run scratch. Committing them meant an interrupted run
# left "pending" drafts in the repo that the NEXT run checked out and sent for
# review, months later and rendered by old code.
oralcheck-agent/queue/
# Posting calendar: the plan is tracked; rendered media lives on the release.
oralcheck-agent/calendar/*/
__pycache__/
*.pyc

# anatomy3d: base64 copies of head.glb for the artifact, regenerated from it
oralcheck-agent/anatomy3d/head.part*.txt
# videos are outputs and stay local (none are tracked); the prototype's node_modules is a symlink
oralcheck-agent/**/*.mp4
oralcheck-agent/reel3d_proto/node_modules
